# ─── Server ───────────────────────────────────────────────────────────────
PORT=5000

# Comma-separated list of allowed frontend origins (Vite dev server default).
# In production, set this to your deployed frontend URL — never allow "*".
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ─── MongoDB Atlas ──────────────────────────────────────────────────────────
# Atlas → Connect → Drivers. Keep the real value out of version control.
# Example: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/dealai
MONGODB_URI=

# ─── AI provider — Google Gemini ────────────────────────────────────────────
# Reasoning layer for negotiation. Get a key: https://aistudio.google.com/apikey
# Leave AI_API_KEY blank to run entirely on the deterministic rules engine.
# NEVER expose these to the frontend. Never commit the real .env.
# NOTE: free-tier daily request quotas are small and per-model. If you see
# HTTP 429 (RESOURCE_EXHAUSTED), you've hit the daily cap — the app falls back
# to the deterministic engine automatically. Enable billing for higher limits.
AI_API_KEY=
AI_MODEL=gemini-3.6-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ─── Authentication (Day 5) ─────────────────────────────────────────────────
# Server-side secret used to sign session tokens (HMAC). NEVER expose to the
# frontend and never commit the real value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If left blank, the server uses an ephemeral per-process secret (dev only).
AUTH_SECRET=

# ─── Payments — Razorpay (Day 8, TEST MODE) ─────────────────────────────────
# Razorpay Dashboard → switch to TEST MODE → Settings → API Keys → Generate.
# The Key ID (rzp_test_...) is PUBLIC and reaches the browser. The Key Secret is
# SERVER-ONLY — never expose it to the frontend and never commit the real value.
# Leave BOTH blank to disable online payment (checkout shows "not configured").
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
